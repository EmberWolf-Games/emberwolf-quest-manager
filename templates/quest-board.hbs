<section class="ewqm-board {{#if isGM}}ewqm-is-gm{{else}}ewqm-is-player{{/if}}">
  <header class="ewqm-masthead">
    <p class="ewqm-guild-name">Emberwolf Adventurers' Guild</p>
    <h1>Quest Board</h1>
    <p class="ewqm-intro">
      {{#if isGM}}
        Draft commissions, publish them for a party vote, and keep the guild board current.
      {{else}}
        Read the posted commissions and cast your vote for the party.
      {{/if}}
    </p>
  </header>

  {{#if isGM}}
    <details class="ewqm-editor ewqm-generator" open>
      <summary>Generate quest drafts</summary>
      <p class="ewqm-generator-intro">Choose the party roster and generation settings. Each draft combines compatible category pools for an action, quantity, target, and payout. Generated quests are saved privately for your review; publishing is a separate step.</p>
      <form data-generator-form autocomplete="off">
        <fieldset class="ewqm-roster">
          <legend>Party roster</legend>
          {{#if hasCharacterActors}}
            <div class="ewqm-roster-list">
              {{#each partyRoster as |actor|}}
                <label class="ewqm-roster-option {{#unless actor.isSelectable}}is-disabled{{/unless}}">
                  <input type="checkbox" name="actorIds" value="{{actor.id}}" {{#if actor.isSelected}}checked{{/if}} {{#unless actor.isSelectable}}disabled{{/unless}}>
                  <span>{{actor.name}}</span>
                  <small>{{actor.levelLabel}}</small>
                </label>
              {{/each}}
            </div>
          {{else}}
            <p class="ewqm-muted">No character actors with a usable dnd5e level are available in this world.</p>
          {{/if}}
          <p class="ewqm-roster-summary">
            {{#if hasPartyRoster}}
              {{partyRosterCount}} selected character(s); party level {{partyLevel}} (average rounded down).
            {{else}}
              Select the player characters who count as the party. No world actors are added automatically.
            {{/if}}
          </p>
        </fieldset>

        <div class="ewqm-generator-fields">
          <label class="ewqm-field">
            <span>Quest category</span>
            <select name="categoryId">
              {{#each generationCategories as |category|}}
                <option value="{{category.id}}">{{category.label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="ewqm-field">
            <span>Challenge</span>
            <select name="difficultyId">
              {{#each challengeOptions as |option|}}
                <option value="{{option.id}}" {{#if option.isDefault}}selected{{/if}}>{{option.label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="ewqm-field">
            <span>Urgency</span>
            <select name="urgencyId">
              {{#each urgencyOptions as |option|}}
                <option value="{{option.id}}">{{option.label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="ewqm-field">
            <span>Encounter budget</span>
            <select name="rulesetId">
              {{#each rulesetOptions as |option|}}
                <option value="{{option.id}}">{{option.label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="ewqm-field">
            <span>Drafts to generate</span>
            <select name="count">
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select>
          </label>
        </div>
        <div class="ewqm-ai-settings">
          <label class="ewqm-field">
            <span>Gemini relay URL (optional)</span>
            <input name="geminiRelayUrl" type="url" maxlength="500" value="{{geminiRelayUrl}}" placeholder="http://127.0.0.1:30001/gemini/clerk-note">
          </label>
          <div class="ewqm-ai-status">
            {{#if hasGeminiRelay}}
              <span>Relay URL saved for this GM browser.</span>
            {{else}}
              <span>No relay configured; drafts use built-in guild-clerk wording.</span>
            {{/if}}
            <button type="button" data-action="save-gemini-relay">Save relay URL</button>
          </div>
          <p class="ewqm-security-note">The module stores only this URL on the GM's browser. Keep your Gemini API key on a server-side relay; only the public title, category, urgency, objective, and reward are sent for note writing. GM notes and party details stay private.</p>
        </div>
        <div class="ewqm-editor-actions">
          <button type="button" data-action="save-party-roster">Save roster</button>
          <button type="button" data-action="generate-quests" class="ewqm-primary">Generate drafts</button>
        </div>
      </form>
      <p class="ewqm-security-note">The party level is the floor of the selected characters' average levels. Reward tables and urgency multipliers are starter balancing values. Combat estimates are not a guarantee of encounter safety.</p>
    </details>

    <details class="ewqm-editor" open>
      <summary>{{#if isEditing}}Edit a commission{{else}}Write a new commission{{/if}}</summary>
      <form data-quest-form autocomplete="off">
        <input type="hidden" name="questId" value="{{editingQuestId}}">
        <label class="ewqm-field">
          <span>Quest title</span>
          <input name="title" maxlength="120" required value="{{editingTitle}}" placeholder="The missing silver shipment">
        </label>
        <label class="ewqm-field">
          <span>Public posting</span>
          <textarea name="description" rows="3" maxlength="4000" required placeholder="What will the guild members read?">{{editingDescription}}</textarea>
        </label>
        <label class="ewqm-field">
          <span>Additional details by guild clerk (player-visible)</span>
          <textarea name="clerkNote" rows="3" maxlength="1200" placeholder="A handwritten-style note for the adventurers.">{{editingClerkNote}}</textarea>
        </label>
        <label class="ewqm-field ewqm-private-field">
          <span>GM only notes</span>
          <textarea name="gmNotes" rows="2" maxlength="4000" placeholder="Private details stay in the GM archive.">{{editingGmNotes}}</textarea>
        </label>
        <div class="ewqm-editor-actions">
          <button type="button" data-action="save-quest" class="ewqm-primary">{{#if isEditing}}Save changes{{else}}Save as draft{{/if}}</button>
          {{#if isEditing}}<button type="button" data-action="cancel-edit">Cancel</button>{{/if}}
        </div>
      </form>
      <p class="ewqm-security-note">Drafts and GM only notes are stored in GM-owned journal records. Only published text is shared with players.</p>
    </details>
  {{/if}}

  <div class="ewqm-board-heading">
    <h2>{{#if isGM}}Guild records{{else}}Open commissions{{/if}}</h2>
    {{#if isGM}}<span>{{quests.length}} total</span>{{/if}}
  </div>

  {{#if hasQuests}}
    <div class="ewqm-quest-list">
      {{#each quests as |quest|}}
        <article class="ewqm-quest-card ewqm-status-{{quest.statusClass}}">
          <div class="ewqm-card-topline">
            <span class="ewqm-status-label">{{quest.statusLabel}}</span>
            {{#if quest.createdLabel}}<time>Posted: {{quest.createdLabel}}</time>{{/if}}
          </div>
          <div class="ewqm-card-crest" aria-hidden="true"><i class="fa-solid fa-shield-halved"></i></div>
          <h3>{{quest.title}}</h3>
          <section class="ewqm-objective">
            <h4>Objective</h4>
            <p class="ewqm-description">{{quest.description}}</p>
          </section>
          {{#if quest.hasPublicDetails}}
            <p class="ewqm-quest-meta">
              {{#if quest.categoryLabel}}<span>{{quest.categoryLabel}}</span>{{/if}}
              {{#if quest.urgencyLabel}}<span>{{quest.urgencyLabel}}</span>{{/if}}
              {{#if quest.rewardLabel}}<span>Reward: {{quest.rewardLabel}}</span>{{/if}}
            </p>
          {{/if}}

          {{#if quest.hasClerkNote}}
            <section class="ewqm-clerk-note" aria-label="Additional details by guild clerk">
              <h4>Additional details by guild clerk</h4>
              <p>{{quest.clerkNote}}</p>
              <span class="ewqm-guild-seal" aria-hidden="true"><i class="fa-solid fa-shield-halved"></i></span>
            </section>
          {{/if}}

          {{#if quest.hasGmNotes}}
            <aside class="ewqm-gm-notes">
              <strong>GM only</strong>
              <p>{{quest.gmNotes}}</p>
            </aside>
          {{/if}}

          {{#if ../isPlayer}}
            <div class="ewqm-party-vote">
              <p class="ewqm-vote-tally">Party vote: {{quest.voteSummary}}</p>
              {{#if quest.canVote}}
                <p class="ewqm-vote-instruction">One vote per player. A strict majority of player accounts decides this commission.</p>
                <div class="ewqm-vote-actions">
                  <button type="button" data-action="cast-party-vote" data-quest-id="{{quest.id}}" data-vote="accept" class="ewqm-accept {{#if quest.isMyAccept}}is-selected{{/if}}">
                    {{#if quest.isMyAccept}}Your vote: Accept{{else}}Accept{{/if}}
                  </button>
                  <button type="button" data-action="cast-party-vote" data-quest-id="{{quest.id}}" data-vote="decline" class="ewqm-decline {{#if quest.isMyDecline}}is-selected{{/if}}">
                    {{#if quest.isMyDecline}}Your vote: Decline{{else}}Decline{{/if}}
                  </button>
                </div>
              {{/if}}
              {{#if quest.pendingOutcome}}
                <p class="ewqm-pending-outcome">A majority has voted. The GM client is synchronizing the result.</p>
              {{/if}}
            </div>
          {{else}}
            <div class="ewqm-gm-vote-summary">
              <span>Party vote: {{quest.voteSummary}}</span>
            </div>
            <div class="ewqm-card-actions">
              <button type="button" data-action="edit-quest" data-quest-id="{{quest.id}}">Edit</button>
              {{#if quest.canPublish}}<button type="button" data-action="publish-quest" data-quest-id="{{quest.id}}" class="ewqm-primary">Publish</button>{{/if}}
              {{#if quest.canClose}}<button type="button" data-action="close-quest" data-quest-id="{{quest.id}}" class="ewqm-danger">Close</button>{{/if}}
              {{#if quest.canReopen}}<button type="button" data-action="reopen-quest" data-quest-id="{{quest.id}}" class="ewqm-primary">Reopen vote</button>{{/if}}
              {{#if quest.canDelete}}
                <button type="button" data-action="delete-quest" data-quest-id="{{quest.id}}" class="ewqm-danger ewqm-delete" aria-pressed="{{quest.isDeleteArmed}}">
                  {{#if quest.isDeleteArmed}}Confirm delete{{else}}Delete{{/if}}
                </button>
              {{/if}}
            </div>
            {{#if quest.isDeleteArmed}}<p class="ewqm-delete-confirmation" role="status">Click “Confirm delete” within 8 seconds to permanently remove this quest.</p>{{/if}}
          {{/if}}
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="ewqm-empty-state">
      {{#if isGM}}
        <p>No guild records yet. Start with a draft above.</p>
      {{else}}
        <p>The guild board is quiet for now. Check back when new work is posted.</p>
      {{/if}}
    </div>
  {{/if}}
</section>
